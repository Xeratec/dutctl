target extended-remote localhost:3333

monitor reset halt

# Load binary
load deps/chimera-sdk/build/bin/test_snitchCluster_sleep

set {int}0x03000000=1
set {int}0x03000004=1
set {int}0x03000008=__V__
set {int}0x0300000C=__F__

# Launch binary
continue

# Exit from GDB
exit
